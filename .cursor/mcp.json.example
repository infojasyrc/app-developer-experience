{
  "mcpServers": {
    "ade-knowledge": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--platform",
        "linux/amd64",
        "-e",
        "ADE_ROOT=/repo",
        "-v",
        "<ADE_ROOT>:/repo:ro",
        "app-dev-exp/knowledge-mcp:latest",
        "python",
        "-m",
        "stdio_main"
      ]
    }
  }
}
