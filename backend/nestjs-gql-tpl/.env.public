HTTP_PORT=4000
INTEGRATION_ENVIRONMENT_URL_LIVENESS=
INTEGRATION_API_TOKEN=
# feature flags integration
UNLEASH_API_URL=
UNLEASH_API_TOKEN=
# database connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=some_password
POSTGRES_DB=postgres
# feature flags database connection
UNLEASH_DB_NAME=unleash
UNLEASH_DB_USERNAME=unleash_user
UNLEASH_DB_PASSWORD=some_password

# containers env variables: not used for deployment
PROJECT_NAME=app-dev-exp
COMPOSE_PROJECT_NAME=nestjs-gql-tpl
# Available platforms: linux/amd64 | linux/arm64 | linux/x86_64
PLATFORM=linux/amd64
# Container engine. Allowed tools: docker | podman | container
CONTAINER_RUNTIME=docker