{
  "name": "nestjs-rest-tpl",
  "version": "0.1.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "commit": "cz",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint-staged": "lint-staged",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "release": "standard-version",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/axios": "^12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/terminus": "^12.1.0",
    "@types/unzipper": "^0.10.11",
    "axios": "^1.20.0",
    "moment": "^2.31.0",
    "papaparse": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "unleash-client": "^6.12.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lint-staged": "^13.3.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^16.1.2",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.9",
    "source-map-support": "^0.5.21",
    "standard-version": "^9.5.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "flatted": "3.4.4",
    "glob@11": "11.1.0",
    "handlebars": "4.7.9",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "lodash": "4.18.1",
    "minimatch@3": "3.1.5",
    "minimatch@5": "5.1.9",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.6",
    "picomatch@2": "2.3.2",
    "tmp": "0.2.7"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-report.xml"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
