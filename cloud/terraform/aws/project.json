{
  "name": "infra-aws-terraform",
  "sourceRoot": "cloud/terraform/aws",
  "projectType": "application",
  "targets": {
    "init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make init",
        "cwd": "cloud/terraform/aws"
      }
    },
    "plan": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make plan",
        "cwd": "cloud/terraform/aws"
      },
      "dependsOn": ["init"]
    },
    "apply": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make apply",
        "cwd": "cloud/terraform/aws"
      },
      "dependsOn": ["plan"]
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make destroy",
        "cwd": "cloud/terraform/aws"
      }
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make validate",
        "cwd": "cloud/terraform/aws"
      }
    },
    "fmt": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make fmt",
        "cwd": "cloud/terraform/aws"
      }
    }
  }
}
