# Container engine. Allowed tools: docker | podman | container
CONTAINER_RUNTIME=docker

# application env variables
ENVIRONMENT=development
# database env variables
# shared MongoDB (../shared-services): DB_* and DEFAULT_DB must match shared-services and ms-conference-api
DB_ROOT_USERNAME=mongoDev
DB_ROOT_PASSWORD=Passw0rd
# use localhost or mongodb
DB_HOST=localhost
DB_PORT=27017
DEFAULT_DB=mongodb
MS_PORT=5002

# containers env variables: not used for deployment
PROJECT_NAME=conference-manager
COMPOSE_PROJECT_NAME=ms-conference
# Available platforms: linux/amd64 | linux/arm64 | linux/x86_64
PLATFORM=linux/amd64
