{
  "name": "ms-conference-webapp",
  "sourceRoot": "conference-manager/ms-conference-webapp",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make build-dev",
        "cwd": "conference-manager/ms-conference-webapp"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make lint",
        "cwd": "conference-manager/ms-conference-webapp"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make unit-tests",
        "cwd": "conference-manager/ms-conference-webapp"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make launch",
        "cwd": "conference-manager/ms-conference-webapp"
      }
    }
  }
}
