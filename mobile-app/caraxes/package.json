    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.0",
